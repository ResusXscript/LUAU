}

-- Mute game audio tracks
local activeSoundTracks = {}
local function muteGameAudio()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Sound") and obj.Playing then
			table.insert(activeSoundTracks, { Sound = obj, WasPlaying = true })
			pcall(function() obj:Pause() end)
		end
	end
end

local function restoreGameAudio()
	for _, data in ipairs(activeSoundTracks) do
		if data.Sound and data.Sound.Parent then
			pcall(function() data.Sound:Resume() end)
		end
	end
end

muteGameAudio()
pcall(function()
	StarterGui:SetCore("TopbarEnabled", true)
end)

