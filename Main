local uiScale = Instance.new("UIScale")
uiScale.Scale = 1
uiScale.Parent = stage

local function updateScale()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local vp = cam.ViewportSize
	if vp.X <= 0 or vp.Y <= 0 then
		return
	end
	local scale = math.min(vp.X / 1280, vp.Y / 720)
	uiScale.Scale = math.clamp(scale, CONFIG.MinScale, CONFIG.MaxScale)
end

updateScale()
local scaleConn = RunService.RenderStepped:Connect(updateScale)

local MATRIX_GLYPHS = {
	"0", "1", "0", "1", "X", "R", "S", "7", "9", "3",
	"ｱ", "ｲ", "ｳ", "ｴ", "ｵ", "ｶ", "ｷ", "ｸ", "ｹ", "ｺ",
	"ｻ", "ｼ", "ｽ", "ｾ", "ｿ", "ﾀ", "ﾁ", "ﾂ", "ﾃ", "ﾄ",
}

type MatrixStream = {
	Label: TextLabel,
	YNorm: number,
	Speed: number,
	GlyphTimer: number,
	Length: number,
}

local matrixStreams: { MatrixStream } = {}
local matrixConn: RBXScriptConnection? = nil

local function buildMatrixText(length: number): string
	local chars = table.create(length)
	for i = 1, length do
		chars[i] = MATRIX_GLYPHS[math.random(1, #MATRIX_GLYPHS)]
	end
	return table.concat(chars, "\n")
end

local function startMatrixRain()
	for _, stream in ipairs(matrixStreams) do
		stream.Label:Destroy()
	end
	table.clear(matrixStreams)

	matrixLayer.Visible = true
	local cols = CONFIG.MatrixColumns
	for i = 1, cols do
		local xScale = (i - 0.5) / cols
		local len = math.random(10, 18)
		local lbl = Instance.new("TextLabel")
		lbl.Name = "MatrixCol_" .. tostring(i)
		lbl.AnchorPoint = Vector2.new(0.5, 0)
		lbl.Size = UDim2.new(1 / cols, 0, 0.45, 0)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.Code
		lbl.TextSize = 15
		lbl.TextColor3 = (i % 3 == 0) and CONFIG.MatrixGreen or CONFIG.MatrixDimGreen
		lbl.TextTransparency = 1
		lbl.TextYAlignment = Enum.TextYAlignment.Top
		lbl.Text = buildMatrixText(len)
		lbl.ZIndex = 1

		local startY = -math.random(10, 80) / 100
		lbl.Position = UDim2.fromScale(xScale, startY)
		lbl.Parent = matrixLayer

		TweenService:Create(lbl, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			TextTransparency = math.random(15, 45) / 100,
		}):Play()

		table.insert(matrixStreams, {
			Label = lbl,
			YNorm = startY,
			Speed = math.random(18, 42) / 100,
			GlyphTimer = 0,
			Length = len,
		})
	end

	if matrixConn and matrixConn.Connected then
		matrixConn:Disconnect()
	end

	matrixConn = RunService.RenderStepped:Connect(function(dt: number)
		for _, stream in ipairs(matrixStreams) do
			stream.YNorm += stream.Speed * dt
			stream.GlyphTimer += dt
			if stream.GlyphTimer >= 0.14 then
				stream.GlyphTimer = 0
				stream.Label.Text = buildMatrixText(stream.Length)
			end
			if stream.YNorm > 1.05 then
				stream.YNorm = -math.random(25, 55) / 100
				stream.Speed = math.random(18, 42) / 100
			end
			local xScale = stream.Label.Position.X.Scale
			stream.Label.Position = UDim2.fromScale(xScale, stream.YNorm)
		end
	end)
end

local function stopMatrixRain()
	for _, stream in ipairs(matrixStreams) do
		TweenService:Create(stream.Label, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			TextTransparency = 1,
		}):Play()
	end
	task.wait(0.45)
	if matrixConn and matrixConn.Connected then
		matrixConn:Disconnect()
		matrixConn = nil
	end
	for _, stream in ipairs(matrixStreams) do
		stream.Label:Destroy()
	end
	table.clear(matrixStreams)
	matrixLayer.Visible = false
end

local IN_INFO = TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local OUT_INFO = TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

local function setGroupAlpha(group: Instance, alpha: number, slideOffsetY: number?, tweenInfo: TweenInfo?)
	local info = tweenInfo or IN_INFO
	if group:IsA("GuiObject") then
		if slideOffsetY ~= nil then
			local basePos = group:GetAttribute("BasePos") :: UDim2?
			if not basePos then
				basePos = group.Position
				group:SetAttribute("BasePos", basePos)
			end
			local targetPos = UDim2.new(basePos.X.Scale, basePos.X.Offset, basePos.Y.Scale, basePos.Y.Offset + slideOffsetY)
			TweenService:Create(group, info, { Position = targetPos }):Play()
		end
		if group:IsA("TextLabel") or group:IsA("TextBox") or group:IsA("TextButton") then
			TweenService:Create(group, info, { TextTransparency = alpha }):Play()
		end
		if group:IsA("Frame") or group:IsA("TextLabel") or group:IsA("TextBox") or group:IsA("TextButton") then
			local initBg = group:GetAttribute("InitBgTransparency") :: number?
			if initBg == nil then
				initBg = group.BackgroundTransparency
				group:SetAttribute("InitBgTransparency", initBg)
			end
			if (initBg :: number) < 1 then
				local targetBg = initBg + (1 - initBg) * alpha
				TweenService:Create(group, info, { BackgroundTransparency = math.clamp(targetBg, 0, 1) }):Play()
			end
		end
	end

	for _, desc in ipairs(group:GetDescendants()) do
		if desc:IsA("TextLabel") or desc:IsA("TextBox") or desc:IsA("TextButton") then
			TweenService:Create(desc, info, { TextTransparency = alpha }):Play()
		end
		if desc:IsA("Frame") or desc:IsA("TextLabel") or desc:IsA("TextBox") or desc:IsA("TextButton") then
			local initBg = desc:GetAttribute("InitBgTransparency") :: number?
			if initBg == nil then
				initBg = desc.BackgroundTransparency
				desc:SetAttribute("InitBgTransparency", initBg)
			end
			if (initBg :: number) < 1 then
				local targetBg = initBg + (1 - initBg) * alpha
				TweenService:Create(desc, info, { BackgroundTransparency = math.clamp(targetBg, 0, 1) }):Play()
			end
		elseif desc:IsA("UIStroke") then
			local initStroke = desc:GetAttribute("InitStrokeTransparency") :: number?
			if initStroke == nil then
				initStroke = desc.Transparency
				desc:SetAttribute("InitStrokeTransparency", initStroke)
			end
			local targetStroke = initStroke + (1 - initStroke) * alpha
			TweenService:Create(desc, info, { Transparency = math.clamp(targetStroke, 0, 1) }):Play()
		end
	end
end

local function animateIn(group: GuiObject)
	group.Visible = true
	setGroupAlpha(group, 1, 18, TweenInfo.new(0.01))
	task.wait(0.02)
	setGroupAlpha(group, 0, 0, IN_INFO)
	task.wait(IN_INFO.Time)
end

local function animateOut(group: GuiObject)
	if not group.Visible then
		return
	end
	setGroupAlpha(group, 1, -16, OUT_INFO)
	task.wait(OUT_INFO.Time)
	group.Visible = false
end

local function createLookSound(): Sound?
	if CONFIG.LookSoundId == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = "EyeLookSound"
	s.SoundId = CONFIG.LookSoundId
	s.Looped = true
	s.Volume = CONFIG.LookVolume
	s.PlaybackSpeed = 1.0
	s.Parent = SoundService

	local pitchShift = Instance.new("PitchShiftSoundEffect")
	pitchShift.Name = "LookPitchShift"
	pitchShift.Octave = 1.0
	pitchShift.Parent = s

	pcall(function()
		s:Play()
	end)
	return s
end

local function playProceedSound()
	if CONFIG.ProceedSoundId == "" then
		return
	end
	local s = Instance.new("Sound")
	s.Name = "ScreenProceedSound"
	s.SoundId = CONFIG.ProceedSoundId
	s.Looped = false
	s.Volume = CONFIG.ProceedVolume
	s.Parent = SoundService

	local cleaned = false
	local function cleanup()
		if cleaned then
			return
		end
		cleaned = true
		pcall(function()
			s:Stop()
			s:Destroy()
		end)
	end

	s.Ended:Once(cleanup)
	task.delay(3.0, cleanup)

	local ok = pcall(function()
		s:Play()
	end)
	if not ok then
		cleanup()
	end
end

